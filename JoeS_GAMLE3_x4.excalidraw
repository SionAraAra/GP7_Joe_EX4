    {
      "id": "Nnb1UwkQsl0l0R9FROF1c",
      "type": "text",
      "x": -790.6376703836593,
      "y": 1776.2064692801275,
      "width": 2136.78662109375,
      "height": 944.9562582406762,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2p",
      "roundness": null,
      "seed": 1465982875,
      "version": 1544,
      "versionNonce": 1655438645,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1768249301172,
      "link": null,
      "locked": false,
      "text": "Puzzle:\nMatchmaker.\nAfter you notice that you are playing cupid and get your powers you feel the need to do your job again\nyou want to make the perfect couples for the caretakers. To do so you need to sneak around in their \nwork and pause area to find out information about them and their preferences. To make them all match.\n\nExample:\nBob is tall and has brown hair - his perfect partner would be short with blond hair\nKevin is tall and has brown hair - his perfect partner would be tall with red hair\n\nSara is short and has blond hair - her perfect partner would be tall with brown hair\nLisa is tall and has red hair - her perfect partner would be tall with brown hair\n\nIf we were to see only the girls preferences it would be impossible but with the info of the others\nwe can make two perfect matches Sara with Bob and Lisa with Kevin.\n\nThe info can be found in the map near the lockers or the kitchen but it can also be heard \nwhen the caretakers talk.",
      "fontSize": 41.99805592180783,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Puzzle:\nMatchmaker.\nAfter you notice that you are playing cupid and get your powers you feel the need to do your job again\nyou want to make the perfect couples for the caretakers. To do so you need to sneak around in their \nwork and pause area to find out information about them and their preferences. To make them all match.\n\nExample:\nBob is tall and has brown hair - his perfect partner would be short with blond hair\nKevin is tall and has brown hair - his perfect partner would be tall with red hair\n\nSara is short and has blond hair - her perfect partner would be tall with brown hair\nLisa is tall and has red hair - her perfect partner would be tall with brown hair\n\nIf we were to see only the girls preferences it would be impossible but with the info of the others\nwe can make two perfect matches Sara with Bob and Lisa with Kevin.\n\nThe info can be found in the map near the lockers or the kitchen but it can also be heard \nwhen the caretakers talk.",
      "autoResize": true,
      "lineHeight": 1.25
    },
