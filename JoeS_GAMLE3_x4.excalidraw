      "boundElements": [],
      "updated": 1770383390479,
      "link": null,
      "locked": false,
      "text": "The caretakers they move on the given pathways and make small stops at the red diamonds\nand look left and right. They have a vision cone of about 5 meters in length and on a total\nvision radius of 90 degrees. When they get you you get send back to the sleeping area but\nyou get to keep your toy and transformation.",
      "fontSize": 44.73032954511146,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The caretakers they move on the given pathways and make small stops at the red diamonds and look left and right. They have a vision cone of about 5 meters in length and on a total vision radius of 90 degrees. When they get you you get send back to the sleeping area but you get to keep your toy and transformation.",
      "autoResize": false,
      "lineHeight": 1.25
    },
