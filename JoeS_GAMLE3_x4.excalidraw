      "type": "text",
      "x": -798.9568731536116,
      "y": 2907.706109408689,
      "width": 2391.8212890625,
      "height": 289.985419413558,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
