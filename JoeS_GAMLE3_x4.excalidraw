      "seed": 188286957,
      "version": 1191,
      "versionNonce": 1100745979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768248802891,
      "link": null,
      "locked": false,
      "text": "Story:\nYou play as a baby/toddler that wants to hide and dodge the caretakers because \nhe dose not want to take a nap but play with his favorite toy that can be located\nanywhere in the main area, it has to be found and brought to the Goal/Play Area \nto win/complete the map. \n\nReveal 1:\nOr so you thought the moment the player starts to play with the\ntoy which is a white and pink bow and arrow toy the players character starts to get small useless wings\nand realizes that they are playing as cupid and that their story is not over yet.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Story:\nYou play as a baby/toddler that wants to hide and dodge the caretakers because \nhe dose not want to take a nap but play with his favorite toy that can be located\nanywhere in the main area, it has to be found and brought to the Goal/Play Area \nto win/complete the map. \n\nReveal 1:\nOr so you thought the moment the player starts to play with the\ntoy which is a white and pink bow and arrow toy the players character starts to get small useless wings\nand realizes that they are playing as cupid and that their story is not over yet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
